local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "momo 🛸",
   Icon = 0,
   LoadingTitle = "momo Script Loading...",
   LoadingSubtitle = "by momo",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = nil,
      FileName = "momoConfig"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvitelink",
      RememberJoins = true
   },
   KeySystem = false
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local LP = LocalPlayer
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

-- System Variables
local SpeedEnabled = false
local JumpEnabled = false
local CustomSpeed = 50
local CustomJump = 100
local NormalSpeed = 16
local NormalJump = 50

local NoclipEnabled = false
local ESPEnabled = false
local ESPNameEnabled = false
local ESPHighlights = {}
local ESPNameTags = {}

-- Hitbox Variables
local HitboxEnabled = false
local HitboxSize = 15
local OriginalHitboxSizes = {}

-- Safe Points Variables
local SavedPositions = {}
local SavedPointNames = {}
local SelectedPointToTP = ""
local SafePointCounter = 1
local SafeInputName = ""

-- Lighting Backup & Variables
local OriginalFogStart = Lighting.FogStart
local OriginalFogEnd = Lighting.FogEnd
local OriginalBrightness = Lighting.Brightness
local OriginalClockTime = Lighting.ClockTime
local OriginalGlobalShadows = Lighting.GlobalShadows
local OriginalAmbient = Lighting.Ambient
local FullbrightEnabled = false

-- New Features Variables
local InfJumpEnabled = false
local FlyEnabled = false
local FlySpeed = 50
local SelectedPlayerToTP = ""
local SelectedPlayerToSpectate = ""
local SpectateEnabled = false
local CurrentFOV = 70

-- Tabs
local MainTab = Window:CreateTab("ฟังก์ชันหลัก / Main 🛸", 4483362458)
local ESPTab = Window:CreateTab("ESP & แสง / Vision 👁️", 4483362458)
local TeleportTab = Window:CreateTab("วาร์ป / Teleport 📍", 4483362458)
local SpectateTab = Window:CreateTab("ส่องผู้เล่น / Spectate 👁️‍🗨️", 4483362458)
local SettingsTab = Window:CreateTab("ตั้งค่า / Settings ⚙", 4483362458)

------------------------------------------------------------------
-- Character Function & Loop Update
------------------------------------------------------------------
local function updateMovement()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        
        if SpeedEnabled then
            humanoid.WalkSpeed = CustomSpeed
        else
            humanoid.WalkSpeed = NormalSpeed
        end

        humanoid.UseJumpPower = true
        if JumpEnabled then
            humanoid.JumpPower = CustomJump
        else
            humanoid.JumpPower = NormalJump
        end
    end
end

RunService.RenderStepped:Connect(function()
    updateMovement()
end)

------------------------------------------------------------------
-- Helper Function for Players Dropdown
------------------------------------------------------------------
local function getOtherPlayerNames()
    local names = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    if #names == 0 then
        return {"ไม่มีผู้เล่นอื่น"}
    end
    return names
end

------------------------------------------------------------------
-- Hitbox System Loop
------------------------------------------------------------------
local function resetHitbox(player)
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local origSize = OriginalHitboxSizes[player] or Vector3.new(2, 2, 1)
        hrp.Size = origSize
        hrp.Transparency = 1
        hrp.BrickColor = BrickColor.new("Medium stone grey")
        hrp.Material = Enum.Material.Plastic
        hrp.CanCollide = false
    end
end

RunService.RenderStepped:Connect(function()
    if HitboxEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                if not OriginalHitboxSizes[player] then
                    OriginalHitboxSizes[player] = hrp.Size
                end
                hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                hrp.Transparency = 0.7
                hrp.BrickColor = BrickColor.new("Really red")
                hrp.Material = Enum.Material.Neon
                hrp.CanCollide = false
            end
        end
    end
end)

------------------------------------------------------------------
-- 1. ฟังก์ชันหลัก (Speed, Jump, Noclip, Fly, InfJump, Hitbox)
------------------------------------------------------------------

-- Toggle Hitbox
MainTab:CreateToggle({
   Name = "เปิดใช้งาน Hitbox (ขยายหัว/ตัว)",
   CurrentValue = false,
   Flag = "HitboxToggle",
   Callback = function(Value)
      HitboxEnabled = Value
      if not HitboxEnabled then
         for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
               resetHitbox(player)
            end
         end
         Rayfield:Notify({Title = "Hitbox 🎯", Content = "ปิดการใช้งาน Hitbox แล้ว", Duration = 2})
      else
         Rayfield:Notify({Title = "Hitbox 🎯", Content = "เปิดใช้งาน Hitbox แล้ว", Duration = 2})
      end
   end,
})

