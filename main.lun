-- 5. ระบบตั้งค่า & ภาษา (Settings)
------------------------------------------------------------------
SettingsTab:CreateDropdown({
   Name = "เลือกภาษา / Select Language",
   Options = {"ภาษาไทย 🇹🇭", "English 🇬🇧"},
   CurrentOption = {"ภาษาไทย 🇹🇭"},
   MultipleOptions = false,
   Flag = "LangDropdown",
   Callback = function(Option)
      local selected = Option[1]
      if selected == "ภาษาไทย 🇹🇭" then
         Rayfield:Notify({
            Title = "momo 🛸",
            Content = "เปลี่ยนภาษาเป็น ภาษาไทย แล้ว",
            Duration = 2,
         })
      else
         Rayfield:Notify({
            Title = "momo 🛸",
            Content = "Language changed to English",
            Duration = 2,
         })
      end
   end,
})

-- Player Join/Leave Update Event
Players.PlayerAdded:Connect(function(player)
    if ESPEnabled then createESP(player) end
    if ESPNameEnabled then createNameESP(player) end
    PlayerTPDropdown:Refresh(getOtherPlayerNames())
    SpectateDropdown:Refresh(getOtherPlayerNames())
end)

Players.PlayerRemoving:Connect(function(player)
    if ESPHighlights[player] then
        ESPHighlights[player]:Destroy()
        ESPHighlights[player] = nil
    end
    if ESPNameTags[player] then
        ESPNameTags[player]:Destroy()
        ESPNameTags[player] = nil
    end
    if OriginalHitboxSizes[player] then
        OriginalHitboxSizes[player] = nil
    end
    
    if SelectedPlayerToSpectate == player.Name then
        resetCameraToSelf()
        SpectateEnabled = false
    end
    
    PlayerTPDropdown:Refresh(getOtherPlayerNames())
    SpectateDropdown:Refresh(getOtherPlayerNames())
end)

Rayfield:Notify({
   Title = "momo 🛸 Loaded!",
   Content = "สคริปต์พร้อมใช้งานแล้วครับ",
   Duration = 4,
   Image = 4483362458,
})
