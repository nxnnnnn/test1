})

MainTab:CreateInput({
   Name = "ตั้งค่าความสูงกระโดด (Custom Jump)",
   PlaceholderText = "เช่น 100 (ปกติ 50)",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num then
         CustomJump = num
         updateMovement()
      end
   end,
})

MainTab:CreateToggle({
   Name = "กระโดดไม่จำกัด (Infinite Jump)",
   CurrentValue = false,
   Flag = "InfJumpToggle",
